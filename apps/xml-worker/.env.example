# Copy this file to .env inside apps/xml-worker when running the worker locally.
# Do not commit your real apps/xml-worker/.env file.

# Optional local UBL XSD artefacts for XML validation jobs.
# These paths stay server-side and are used only for local/offline technical
# XSD validation. Invoice Lantern does not download schemas or fetch remote
# schema locations. If these are blank, xsd_ubl returns not_configured and does
# not mark XML as valid.
UBL_XSD_ROOT_DIR=""
UBL_INVOICE_XSD_PATH=""
UBL_CREDIT_NOTE_XSD_PATH=""
UBL_XSD_ARTIFACT_VERSION=""

# Optional server-side Schematron artefacts for XML validation jobs.
# Guarded local Schematron execution is disabled unless explicitly enabled
# below. These paths must point to reviewed local artefacts; Invoice Lantern
# does not download Schematron files or fetch remote includes.
PEPPOL_SCHEMATRON_ROOT_DIR=""
PEPPOL_BIS_SCHEMATRON_PATH=""
EN16931_SCHEMATRON_PATH=""
SCHEMATRON_ARTIFACT_VERSION=""

# Optional Schematron execution policy for XML validation jobs.
# Blank/default values keep Schematron disabled or preflight-only:
# validationExecuted=false and markedValid=false.
# Guarded local execution requires all of:
# SCHEMATRON_EXECUTION_MODE="execute"
# SCHEMATRON_ENGINE="xpath_engine"
# SCHEMATRON_ALLOW_EXPERIMENTAL_EXECUTION="true"
# readable local artefacts inside PEPPOL_SCHEMATRON_ROOT_DIR and safe XML.
# Unsupported Schematron/XPath constructs, remote fetching, unsafe XML, local
# file reads, and network reads fail safely and are not marked valid.
# A Schematron pass is a technical sandbox result only. It is not official,
# certified, legal, tax, accounting, filing, authority, or compliance advice.
SCHEMATRON_EXECUTION_MODE=""
SCHEMATRON_ENGINE=""
SCHEMATRON_ALLOW_EXPERIMENTAL_EXECUTION=""

# Transient XML payload storage for async worker processing.
XML_TRANSIENT_PAYLOAD_DIR=""
XML_TRANSIENT_PAYLOAD_TTL_SECONDS="600"
API_BODY_LIMIT_BYTES="2097152"

# Optional local JSON queue data path. Supabase-backed worker deployments
# should configure the Supabase server-side variables instead.
XML_VALIDATION_JOB_DATA_DIR=""

# Supabase project values for worker/server-side use.
# Do not expose service role, JWT secret, database URL, or private tokens to
# browser clients, logs, docs, or examples with real values.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
DATABASE_URL=""

# Copy this file to .env.local inside apps/web.
# Do not commit .env.local.

NEXT_PUBLIC_APP_NAME="Invoice Lantern"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only local API proxy values.
# These are read only by Next.js route handlers.
# Do not prefix secrets with NEXT_PUBLIC.
INVOICE_LANTERN_API_BASE_URL="http://127.0.0.1:4000"
INVOICE_LANTERN_DEV_API_KEY="il_dev_local_key_change_me_32_chars"

# Supabase browser-safe values.
# Prefer the publishable key for new Supabase projects.
# If your project still uses the older anon key, you can use NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

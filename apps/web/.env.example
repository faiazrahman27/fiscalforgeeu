# Copy this file to .env.local inside apps/web.
# Do not commit .env.local.

NEXT_PUBLIC_APP_NAME="Invoice Lantern"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Runtime environment hint for browser/server UI logic.
# Use "development" locally and "production" in production deployments.
NEXT_PUBLIC_APP_ENV="development"

# Public-safe PWA install prompt switch. The service worker still keeps
# authenticated workspace/API data network-only and no-store.
NEXT_PUBLIC_ENABLE_PWA_INSTALL_PROMPT="true"

# Public contact channels shown on /contact.
# Leave blank until real reviewed inboxes exist.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_SECURITY_CONTACT_EMAIL=""
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=""
NEXT_PUBLIC_INCIDENT_CONTACT_EMAIL=""

# Server-only API proxy base URL.
# This is read only by Next.js route handlers.
# Do not prefix server-only values with NEXT_PUBLIC.
INVOICE_LANTERN_API_BASE_URL="http://127.0.0.1:4000"

# Development-only API bootstrap key.
# Required locally when the dedicated API runs with APP_ENV=development or APP_ENV=test.
# Must be blank/omitted in production because the production API forbids DEV_API_KEY.
# Production workspace requests should use Supabase bearer authentication forwarded by the web proxy.
INVOICE_LANTERN_DEV_API_KEY="il_dev_local_key_change_me_32_chars"

# Supabase browser-safe values.
# Prefer the publishable key for new Supabase projects.
# If your project still uses the older anon key, you can use NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

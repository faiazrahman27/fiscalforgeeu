# Copy this file to .env inside apps/api.
# Do not commit your real apps/api/.env file.

APP_ENV="development"

API_HOST="127.0.0.1"
API_PORT="4000"

WEB_APP_URL="http://localhost:3000"

# API storage backend policy.
#
# auto:
#   development/test uses Supabase when configured, otherwise local JSON storage.
#   production resolves to Supabase only.
#
# supabase:
#   always require Supabase-backed persistence.
#
# json:
#   local development/test only.
#   forbidden in production.
API_STORAGE_BACKEND="auto"

# Local development key only.
# Must match apps/web/.env.local -> INVOICE_LANTERN_DEV_API_KEY.
# Must be blank/omitted in production.
# Production API access must use Supabase bearer authentication or hashed
# database-backed organization API keys.
DEV_API_KEY="il_dev_local_key_change_me_32_chars"

RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="1 minute"

# 2 MB XML/API body limit. Keep this aligned with the web XML upload limit.
API_BODY_LIMIT_BYTES="2097152"

# Optional local UBL XSD artefacts for XML validation jobs.
# These paths stay server-side.
UBL_XSD_ROOT_DIR=""
UBL_INVOICE_XSD_PATH=""
UBL_CREDIT_NOTE_XSD_PATH=""
UBL_XSD_ARTIFACT_VERSION=""

# Optional server-side Schematron artefact diagnostics for XML validation jobs.
# These values do not enable production Schematron execution, Peppol validation,
# or EN 16931 validation yet.
PEPPOL_SCHEMATRON_ROOT_DIR=""
PEPPOL_BIS_SCHEMATRON_PATH=""
EN16931_SCHEMATRON_PATH=""
SCHEMATRON_ARTIFACT_VERSION=""

# Optional Schematron execution policy metadata for XML validation jobs.
# Execution-like values such as "enabled", "execute", or "production" are
# blocked until a future step explicitly implements a reviewed engine.
SCHEMATRON_EXECUTION_MODE=""
SCHEMATRON_ENGINE=""
SCHEMATRON_ALLOW_EXPERIMENTAL_EXECUTION=""

# Transient XML payload storage.
# Development may use local disk. Production should use a reviewed temporary
# storage strategy and retention policy before enabling public XML uploads.
XML_TRANSIENT_PAYLOAD_DIR=""
XML_TRANSIENT_PAYLOAD_TTL_SECONDS="600"

# Supabase project values for API/server-side use.
# Do not expose service role, JWT secret, or database URL to the web/browser app.
# Required in production.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# Supabase Postgres connection string.
# Keep this server-only.
# Required in production.
DATABASE_URL=""

# Server-side secrets.
# Required in production.
VAT_FINGERPRINT_SECRET=""
API_KEY_HASH_SECRET=""
# Copy this file to .env inside apps/api.
# Do not commit your real apps/api/.env file.

APP_ENV="development"

API_HOST="127.0.0.1"
API_PORT="4000"

WEB_APP_URL="http://localhost:3000"

# API storage backend policy.
#
# auto:
#   development/test uses Supabase when configured, otherwise local JSON storage.
#   production resolves to Supabase only.
#
# supabase:
#   always require Supabase-backed persistence.
#
# json:
#   local development/test only.
#   forbidden in production.
API_STORAGE_BACKEND="auto"

# Local development key only.
# Must match apps/web/.env.local -> INVOICE_LANTERN_DEV_API_KEY.
# Must be blank/omitted in production.
# Production API access must use Supabase bearer authentication or hashed
# database-backed organization API keys.
DEV_API_KEY="il_dev_local_key_change_me_32_chars"

# Backend-only platform admin allow-list.
# Comma-separated signed-user emails allowed to manage platform validation
# rule intelligence, source references, and country-pack review metadata.
# Keep this server-side. Do not expose it to the web app, logs, or public
# examples with real addresses. Organization API keys and workspace owner/admin
# roles alone do not grant platform rule publishing rights.
PLATFORM_ADMIN_EMAILS=""

RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="1 minute"

# 2 MB XML/API body limit. Keep this aligned with the web XML upload limit.
API_BODY_LIMIT_BYTES="2097152"

# Optional local UBL XSD artefacts for XML validation jobs.
# These paths stay server-side and are used only for local/offline technical
# XSD validation. Invoice Lantern does not download schemas or fetch remote
# schema locations. If these are blank, xsd_ubl returns not_configured and does
# not mark XML as valid.
UBL_XSD_ROOT_DIR=""
UBL_INVOICE_XSD_PATH=""
UBL_CREDIT_NOTE_XSD_PATH=""
UBL_XSD_ARTIFACT_VERSION=""

# Optional server-side Schematron artefacts for XML validation jobs.
# Guarded local Schematron execution is disabled unless explicitly enabled
# below. These paths must point to reviewed local artefacts; Invoice Lantern
# does not download Schematron files or fetch remote includes.
PEPPOL_SCHEMATRON_ROOT_DIR=""
PEPPOL_BIS_SCHEMATRON_PATH=""
EN16931_SCHEMATRON_PATH=""
SCHEMATRON_ARTIFACT_VERSION=""

# Optional Schematron execution policy for XML validation jobs.
# Blank/default values keep Schematron disabled or preflight-only:
# validationExecuted=false and markedValid=false.
# Guarded local execution requires all of:
# SCHEMATRON_EXECUTION_MODE="execute"
# SCHEMATRON_ENGINE="xpath_engine"
# SCHEMATRON_ALLOW_EXPERIMENTAL_EXECUTION="true"
# readable local artefacts inside PEPPOL_SCHEMATRON_ROOT_DIR and safe XML.
# Unsupported Schematron/XPath constructs, remote fetching, unsafe XML, local
# file reads, and network reads fail safely and are not marked valid.
# A Schematron pass is a technical sandbox result only. It is not official,
# certified, legal, tax, accounting, filing, authority, or compliance advice.
SCHEMATRON_EXECUTION_MODE=""
SCHEMATRON_ENGINE=""
SCHEMATRON_ALLOW_EXPERIMENTAL_EXECUTION=""

# Optional VIES evidence checks.
# Disabled by default. Live VIES is only called when VIES_CHECK_ENABLED is true
# and an endpoint explicitly requests VIES evidence. VAT format valid is not
# VIES valid; VIES unavailable is not invalid; VIES evidence is time-of-check
# evidence only and is not legal/tax/accounting/filing advice.
VIES_CHECK_ENABLED=""
VIES_SERVICE_URL=""
VIES_TIMEOUT_MS="5000"
VIES_RATE_LIMIT_PER_ORG_PER_DAY="100"
VIES_RATE_LIMIT_PER_VAT_PER_DAY="10"

# Backend-only webhook simulator settings.
# WEBHOOK_SECRET_ENCRYPTION_KEY is required before creating or rotating
# persistent webhook signing secrets. Use at least 32 random characters; never
# expose it to browser apps, logs, docs with real values, or examples.
# WEBHOOK_ALLOW_LOCALHOST_DELIVERY should stay false outside local development.
# Deliveries are signed sandbox test events only. They are not official filing,
# authority submission, legal/tax/accounting advice, or compliance evidence.
WEBHOOK_SECRET_ENCRYPTION_KEY=""
WEBHOOK_SIGNING_KEY_ID="webhook-signing-v1"
WEBHOOK_DELIVERY_TIMEOUT_MS="5000"
WEBHOOK_MAX_RESPONSE_BYTES="4096"
WEBHOOK_MAX_RETRY_ATTEMPTS="3"
WEBHOOK_ALLOW_LOCALHOST_DELIVERY="false"

# Transient XML payload storage.
# Development may use local disk. Production should use a reviewed temporary
# storage strategy and retention policy before enabling public XML uploads.
XML_TRANSIENT_PAYLOAD_DIR=""
XML_TRANSIENT_PAYLOAD_TTL_SECONDS="600"

# Optional monitoring and incident-readiness placeholders.
# These are server-side configuration hints only. Readiness endpoints expose
# configured/unconfigured booleans, not provider names, credentials, or contact
# values. Do not put provider tokens, DSNs, webhook URLs, or secrets here.
MONITORING_PROVIDER=""
SECURITY_CONTACT_EMAIL=""
INCIDENT_CONTACT_EMAIL=""

# Supabase project values for API/server-side use.
# Do not expose service role, JWT secret, or database URL to the web/browser app.
# Required in production.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# Supabase Postgres connection string.
# Keep this server-only.
# Required in production.
DATABASE_URL=""

# Server-side secrets.
# Required in production.
VAT_FINGERPRINT_SECRET=""
API_KEY_HASH_SECRET=""

# Copy this file to .env inside apps/api.
# Do not commit your real apps/api/.env file.

APP_ENV="development"

API_HOST="127.0.0.1"
API_PORT="4000"

WEB_APP_URL="http://localhost:3000"

# Local development key only.
# Later this will be replaced by hashed database-backed API keys.
# Must match apps/web/.env.local -> INVOICE_LANTERN_DEV_API_KEY.
DEV_API_KEY="il_dev_local_key_change_me_32_chars"

RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="1 minute"

# 2 MB XML/API body limit. Keep this aligned with the web XML upload limit.
API_BODY_LIMIT_BYTES="2097152"

# Optional server-side Schematron artefact diagnostics for XML validation jobs.
# Step 48 uses these only for metadata-only safe diagnostics when
# schematron_peppol_placeholder is requested. These values do not enable
# Schematron execution, Peppol validation, or EN 16931 validation yet.
PEPPOL_SCHEMATRON_ROOT_DIR=""
PEPPOL_BIS_SCHEMATRON_PATH=""
EN16931_SCHEMATRON_PATH=""
SCHEMATRON_ARTIFACT_VERSION=""

# Supabase project values for API/server-side use.
# Do not expose service role, JWT secret, or database URL to the web/browser app.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# Supabase Postgres connection string.
# Keep this server-only. Later this will be used for migrations and database-backed repositories.
DATABASE_URL=""


VAT_FINGERPRINT_SECRET=""
API_KEY_HASH_SECRET=""

{
  "name": "invoice-lantern-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:packages": "npm --prefix ../../packages/tax-engine run build && npm --prefix ../../packages/invoice-core run build && npm --prefix ../../packages/ubl run build && npm --prefix ../../packages/country-packs run build && npm --prefix ../../packages/vida-simulator run build",
    "predev": "npm run build:packages",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build:packages",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build:packages",
    "start": "node dist/server.js",
    "precheck": "npm run build:packages",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build:packages",
    "test": "tsx --import ./src/test/setup-env.ts --test src/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@invoice-lantern/country-packs": "file:../../packages/country-packs",
    "@invoice-lantern/invoice-core": "file:../../packages/invoice-core",
    "@invoice-lantern/tax-engine": "file:../../packages/tax-engine",
    "@invoice-lantern/ubl": "file:../../packages/ubl",
    "@invoice-lantern/vida-simulator": "file:../../packages/vida-simulator",
    "@supabase/supabase-js": "^2.104.1",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.7.2",
    "fastify": "^5.8.5",
    "invoice-lantern-platform": "file:../..",
    "pdfkit": "^0.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}

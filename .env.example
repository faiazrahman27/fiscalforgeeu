# Optional server-side Schematron artefact diagnostics for API/XML worker jobs.
# Step 48 uses these only for metadata-only safe diagnostics when
# schematron_peppol_placeholder is requested. They do not enable Schematron
# execution, Peppol validation, or EN 16931 validation yet.
PEPPOL_SCHEMATRON_ROOT_DIR=""
PEPPOL_BIS_SCHEMATRON_PATH=""
EN16931_SCHEMATRON_PATH=""
SCHEMATRON_ARTIFACT_VERSION=""

# Optional Schematron execution policy metadata for API/XML worker jobs.
# Step 51 keeps Schematron execution disabled. These variables only affect
# policy metadata returned by schematron_peppol_placeholder.
# Execution-like values such as "enabled", "execute", or "production" are
# blocked until a future step explicitly implements a reviewed engine.
# Do not configure production Schematron execution from these variables yet.
SCHEMATRON_EXECUTION_MODE=""
SCHEMATRON_ENGINE=""
SCHEMATRON_ALLOW_EXPERIMENTAL_EXECUTION=""

# Optional local UBL XSD artefacts for API/XML worker jobs.
# These paths stay server-side and are used only for local/offline technical
# XSD validation. Invoice Lantern does not download schemas or fetch remote
# schema locations. If these are blank, xsd_ubl returns not_configured and does
# not mark XML as valid.
UBL_XSD_ROOT_DIR=""
UBL_INVOICE_XSD_PATH=""
UBL_CREDIT_NOTE_XSD_PATH=""
UBL_XSD_ARTIFACT_VERSION=""

# Optional server-side Schematron artefacts for API/XML worker jobs.
# Step 8 can run guarded local Schematron execution only when explicitly
# enabled below. These paths must point to reviewed local artefacts; Invoice
# Lantern does not download Schematron files or fetch remote includes.
PEPPOL_SCHEMATRON_ROOT_DIR=""
PEPPOL_BIS_SCHEMATRON_PATH=""
EN16931_SCHEMATRON_PATH=""
SCHEMATRON_ARTIFACT_VERSION=""

# Optional Schematron execution policy for API/XML worker jobs.
# Blank/default values keep Schematron disabled or preflight-only:
# validationExecuted=false and markedValid=false.
# Guarded local execution requires all of:
# SCHEMATRON_EXECUTION_MODE="execute"
# SCHEMATRON_ENGINE="xpath_engine"
# SCHEMATRON_ALLOW_EXPERIMENTAL_EXECUTION="true"
# readable local artefacts inside PEPPOL_SCHEMATRON_ROOT_DIR and safe XML.
# Unsupported Schematron/XPath constructs, remote fetching, unsafe XML, local
# file reads, and network reads fail safely and are not marked valid.
# A Schematron pass is a technical sandbox result only. It is not official,
# certified, legal, tax, accounting, filing, authority, or compliance advice.
SCHEMATRON_EXECUTION_MODE=""
SCHEMATRON_ENGINE=""
SCHEMATRON_ALLOW_EXPERIMENTAL_EXECUTION=""

# Optional VIES evidence checks for API validation flows.
# Disabled by default. Live VIES is only called when explicitly enabled and
# requested. VAT format valid is not VIES valid; VIES unavailable is not
# invalid; VIES evidence is time-of-check evidence only.
VIES_CHECK_ENABLED=""
VIES_SERVICE_URL=""
VIES_TIMEOUT_MS="5000"
VIES_RATE_LIMIT_PER_ORG_PER_DAY="100"
VIES_RATE_LIMIT_PER_VAT_PER_DAY="10"

# Backend-only webhook simulator settings.
# WEBHOOK_SECRET_ENCRYPTION_KEY is required before creating or rotating
# persistent webhook signing secrets. Use at least 32 random characters; never
# expose it to browser apps, logs, docs with real values, or examples.
# Deliveries are signed sandbox test events only. They are not official filing,
# authority submission, legal/tax/accounting advice, or compliance evidence.
WEBHOOK_SECRET_ENCRYPTION_KEY=""
WEBHOOK_SIGNING_KEY_ID="webhook-signing-v1"
WEBHOOK_DELIVERY_TIMEOUT_MS="5000"
WEBHOOK_MAX_RESPONSE_BYTES="4096"
WEBHOOK_MAX_RETRY_ATTEMPTS="3"
WEBHOOK_ALLOW_LOCALHOST_DELIVERY="false"

# Backend-only platform admin allow-list.
# Comma-separated signed-user emails allowed to manage platform rule
# intelligence, source references, and country-pack review metadata. Do not
# expose this value to browser apps, logs, or public docs with real addresses.
# Organization API keys and workspace owner/admin roles do not grant platform
# rule publishing rights.
PLATFORM_ADMIN_EMAILS=""
